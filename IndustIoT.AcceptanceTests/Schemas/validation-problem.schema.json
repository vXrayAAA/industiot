{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industiot.fiap/schemas/validation-problem.schema.json",
  "title": "validation-problem",
  "description": "ValidationProblemDetails — 400 gerado pelo FluentValidation",
  "type": "object",
  "required": [
    "title",
    "status",
    "errors"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": 400
    },
    "errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traceId": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
