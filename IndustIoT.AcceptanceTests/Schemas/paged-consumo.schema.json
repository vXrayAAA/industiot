{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industiot.fiap/schemas/paged-consumo.schema.json",
  "title": "paged-consumo",
  "description": "PagedResult<ConsumoLeituraResponse> — GET /api/equipamentos/{id}/consumo",
  "type": "object",
  "required": [
    "items",
    "pageNumber",
    "pageSize",
    "totalCount",
    "totalPages",
    "hasPreviousPage",
    "hasNextPage"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "consumo-leitura.schema.json"
      }
    },
    "pageNumber": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "hasPreviousPage": {
      "type": "boolean"
    },
    "hasNextPage": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
