{
  "info": {
    "_postman_id": "b7a2f1c4-1e2d-4f5a-9c3b-industiot2026",
    "name": "IndústIoT API",
    "description": "Monitoramento de eficiência energética e atuação remota em equipamentos industriais (ESG — FIAP).\n\nFluxo sugerido:\n1. Autenticação > Login (Gestor) — o token JWT é salvo automaticamente na variável {{token}}.\n2. Equipamentos > Criar equipamento.\n3. Leituras > Registrar leitura (dentro do limite e acima do limite).\n4. Alertas > Listar / Resolver.\n5. Equipamentos > Comando de desligamento (exige role Gestor).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Login (Gestor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "console.log('Token salvo na variável {{token}} — expira em ' + json.expiraEm);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"rodrigo.m\",\n  \"senha\": \"IndustIoT@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica o Gestor de Manutenção e salva o JWT automaticamente na variável {{token}}."
          }
        },
        {
          "name": "Login (Operador — sem permissão de comando)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "console.log('Token de OPERADOR salvo — o comando de desligamento deve retornar 403.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"operador.l2\",\n  \"senha\": \"Operador@2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Use este login para demonstrar o 403: Operador é autenticado, mas não tem a role Gestor exigida pelo comando de desligamento."
          }
        }
      ]
    },
    {
      "name": "02 - Equipamentos",
      "item": [
        {
          "name": "Criar equipamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"CMP-02\",\n  \"nome\": \"Compressor de ar — Linha 2\",\n  \"fabricante\": \"Atlas Copco\",\n  \"modelo\": \"GA 55\",\n  \"setor\": \"Utilidades\",\n  \"linhaProducao\": \"Linha 2\",\n  \"potenciaNominalWatts\": 55000,\n  \"limiteConsumoKwh\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/equipamentos",
              "host": ["{{base_url}}"],
              "path": ["api", "equipamentos"]
            },
            "description": "TAG duplicada retorna 422 (regra de negócio). TAG fora do padrão (ex.: 'compressor1') retorna 400 (FluentValidation)."
          }
        },
        {
          "name": "Listar equipamentos (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/equipamentos?pageNumber=1&pageSize=10",
              "host": ["{{base_url}}"],
              "path": ["api", "equipamentos"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "setor", "value": "Utilidades", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Detalhar equipamento",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/equipamentos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "equipamentos", "1"]
            }
          }
        },
        {
          "name": "Histórico de consumo (paginado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/equipamentos/1/consumo?pageNumber=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["api", "equipamentos", "1", "consumo"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "inicio", "value": "2026-06-01T00:00:00Z", "disabled": true },
                { "key": "fim", "value": "2026-06-30T23:59:59Z", "disabled": true }
              ]
            },
            "description": "Consulta otimizada: a ordenação por data descendente casa com o índice composto (EquipamentoId, DataHoraLeitura DESC)."
          }
        },
        {
          "name": "Comando de desligamento (JWT Gestor)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Equipamento ocioso fora do turno — economia de energia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/equipamentos/1/comando-desligamento",
              "host": ["{{base_url}}"],
              "path": ["api", "equipamentos", "1", "comando-desligamento"]
            },
            "description": "Endpoint crítico (tema ESG: desligamento de equipamentos ociosos).\n- Sem token: 401\n- Token de Operador: 403\n- Equipamento já desligado: 422\n- Equipamento em manutenção: 422"
          }
        }
      ]
    },
    {
      "name": "03 - Leituras (Gateway IoT)",
      "item": [
        {
          "name": "Registrar leitura (dentro do limite)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipamentoTag\": \"CMP-02\",\n  \"consumoKwh\": 32.5,\n  \"temperaturaCelsius\": 71,\n  \"vibracaoMmPorSegundo\": 2.1,\n  \"correnteAmperes\": 84.2,\n  \"dataHoraLeitura\": \"2026-06-10T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leituras",
              "host": ["{{base_url}}"],
              "path": ["api", "leituras"]
            },
            "description": "Consumo abaixo do limite do equipamento: alertaGerado = false."
          }
        },
        {
          "name": "Registrar leitura (gera alerta crítico)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipamentoTag\": \"CMP-02\",\n  \"consumoKwh\": 82.0,\n  \"temperaturaCelsius\": 92,\n  \"vibracaoMmPorSegundo\": 7.4,\n  \"correnteAmperes\": 86.2,\n  \"dataHoraLeitura\": \"2026-06-10T13:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/leituras",
              "host": ["{{base_url}}"],
              "path": ["api", "leituras"]
            },
            "description": "82 kWh com limite de 50 = 64% de excesso → alerta com severidade Critica, criado na mesma transação da leitura."
          }
        }
      ]
    },
    {
      "name": "04 - Alertas",
      "item": [
        {
          "name": "Listar alertas (paginado, filtros)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/alertas?pageNumber=1&pageSize=10",
              "host": ["{{base_url}}"],
              "path": ["api", "alertas"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "resolvido", "value": "false", "disabled": true },
                { "key": "severidade", "value": "Critica", "disabled": true }
              ]
            },
            "description": "Ordenados por severidade (Critica primeiro) e depois por data. Filtros opcionais: resolvido e severidade (Atencao, Alta, Critica)."
          }
        },
        {
          "name": "Resolver alerta (JWT)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/alertas/1/resolver",
              "host": ["{{base_url}}"],
              "path": ["api", "alertas", "1", "resolver"]
            },
            "description": "Exige autenticação (qualquer role). Alerta já resolvido retorna 422."
          }
        }
      ]
    }
  ]
}
